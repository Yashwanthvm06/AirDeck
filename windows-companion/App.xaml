<Application x:Class="TouchDeckCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- TouchDeck Dark Theme -->
        <Color x:Key="BgDark">#FF0D0D12</Color>
        <Color x:Key="BgCard">#FF16161E</Color>
        <Color x:Key="BgSurface">#FF1E1E2A</Color>
        <Color x:Key="AccentCyan">#FF00D4FF</Color>
        <Color x:Key="AccentCyanDim">#FF0088AA</Color>
        <Color x:Key="TextPrimary">#FFE8E8EE</Color>
        <Color x:Key="TextSecondary">#FF8888A0</Color>
        <Color x:Key="SuccessGreen">#FF00E676</Color>
        <Color x:Key="ErrorRed">#FFFF4444</Color>
        <Color x:Key="WarningAmber">#FFFFAB40</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
        <SolidColorBrush x:Key="AccentCyanDimBrush" Color="{StaticResource AccentCyanDim}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
        <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}"/>

        <!-- Button Style -->
        <Style x:Key="AirDeskButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2A2A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0088AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchDeckButton" TargetType="Button" BasedOn="{StaticResource AirDeskButton}" />

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TouchDeckButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0088AA" Offset="0"/>
                        <GradientStop Color="#FF00D4FF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FF0D0D12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Application.Resources>
</Application>
