<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit cleartext traffic for local Wi-Fi / LAN communication with TouchDeck PC Companion -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
